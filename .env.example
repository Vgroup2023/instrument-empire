# --- Database (this app's own standalone storage) ---
# Postgres connection string (Supabase, Neon, etc.) — required.
DATABASE_URL=

# --- App access ---
# Simple shared passphrase that gates the whole app (this is an internal
# accounts-department tool, not a multi-tenant SaaS product).
APP_PASSWORD=change-me
# Random 32+ char secret used to sign the app's session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Public URL this app is served from (used to build the OAuth redirect URI).
APP_BASE_URL=http://localhost:3000

# --- QuickBooks Online (Intuit Developer) — entirely optional ---
# Nothing currently built in this app requires this. Leave these blank
# unless you plan to click "Connect QuickBooks" in Settings, which today
# is not needed for anything — see the README's "What's live vs. demo
# data" section. If you do want to set it up: create an app at
# https://developer.intuit.com/app/developer/myapps and copy its keys
# here. Use "sandbox" while testing against a QBO sandbox company, then
# switch to "production" for the real company file.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI configured on the Intuit app.
QBO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Outbound email (SMTP) ---
# Only needed to actually send invoice/estimate emails and payment reminders.
# Without these, Send/Remind fail with a clear "email isn't configured" error;
# everything else about Invoices/Estimates works fine either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Feature providers ---
# QuickBooks Payments (payment links), QuickBooks Payroll, QuickBooks Capital,
# and industry benchmarking all require separate Intuit product access beyond
# the standard Accounting API scope. Until that access is provisioned, these
# modules run against realistic in-memory demo data so the UI is fully
# usable end to end. Flip to "live" once the corresponding Intuit
# integration/credentials are in place (see README for the wiring points).
PAYMENTS_PROVIDER=mock
PAYROLL_PROVIDER=mock
CAPITAL_PROVIDER=mock
BENCHMARK_PROVIDER=mock

# --- Scheduled jobs ---
# Required for the daily agent run (/api/agents/run). The scheduler sends it
# as "Authorization: Bearer <CRON_SECRET>". If unset, only a signed-in user
# can run the agents (via the Run all now button).
CRON_SECRET=
