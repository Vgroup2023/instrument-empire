# Backend
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret_string

# Admin seed account (created on first run)
ADMIN_EMAIL=admin@freightempire.com
ADMIN_PASSWORD=Admin123!

# Anthropic AI (for AI Marketing tab)
ANTHROPIC_API_KEY=sk-ant-...

# Email (Nodemailer - configure for your SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=FreightEmpire <no-reply@freightempire.com>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567
